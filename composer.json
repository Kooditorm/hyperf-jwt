{
    "name": "kooditorm/hyperf-jwt",
    "description": "JSON Web Token Authentication for Hyperf, adapted from tymon/jwt-auth",
    "keywords": ["auth", "authentication", "jwt", "hyperf", "json web token"],
    "homepage": "https://github.com/kooditorm/hyperf-jwt",
    "license": "MIT",
    "authors": [
        {
            "name": "oswin.hu",
            "email": "oswin.hu@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "hyperf/cache": "~3.1.0 || ~3.2.0",
        "hyperf/collection": "~3.1.0 || ~3.2.0",
        "hyperf/config": "~3.1.0 || ~3.2.0",
        "hyperf/context": "~3.1.0 || ~3.2.0",
        "hyperf/contract": "~3.1.0 || ~3.2.0",
        "hyperf/framework": "~3.1.0 || ~3.2.0",
        "hyperf/http-server": "~3.1.0 || ~3.2.0",
        "hyperf/stringable": "~3.1.0 || ~3.2.0",
        "hyperf/utils": "~3.1.0 || ~3.2.0",
        "lcobucci/jwt": "^4.0 || ^5.0",
        "nesbot/carbon": "^2.0 || ^3.0",
        "psr/container": "^1.0 || ^2.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server": "^1.0",
        "psr/simple-cache": "^1.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "hyperf/testing": "~3.1.0 || ~3.2.0",
        "mockery/mockery": "^1.0",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^9.5 || ^10.0",
        "swoole/ide-helper": "dev-master"
    },
    "suggest": {
        "hyperf/database": "Required to use the default HyperfAuth provider with Eloquent models",
        "hyperf/redis": "Required to use Redis as blacklist storage"
    },
    "autoload": {
        "psr-4": {
            "Kooditorm\\Hyperf\\Jwt\\": "src/"
        }
    },
    "extra": {
        "hyperf": {
            "config": "Kooditorm\\Hyperf\\Jwt\\ConfigProvider"
        }
    }
}
